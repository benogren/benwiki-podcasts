# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Webhook auth (Benwiki sends this as Bearer token)
BENWIKI_WEBHOOK_TOKEN=

# RSS feed token (the path segment in /feed/<token>.xml)
RSS_FEED_TOKEN=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_HOST_VOICE_ID=
ELEVENLABS_GUEST_VOICE_ID=

# Show metadata (used in RSS feed)
PODCAST_TITLE=Benwiki Podcasts
PODCAST_AUTHOR=Ben Ogren
PODCAST_OWNER_EMAIL=ben@ogren.me
PODCAST_DESCRIPTION=Auto-generated podcast episodes from my Benwiki knowledge base.
PODCAST_BASE_URL=http://localhost:3000
PODCAST_COVER_URL=http://localhost:3000/cover.jpg
PODCAST_LANGUAGE=en-us
PODCAST_CATEGORY=Technology
